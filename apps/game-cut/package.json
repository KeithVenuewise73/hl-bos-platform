{
  "name": "@hl-bos/game-cut-app",
  "version": "0.1.0",
  "private": true,
  "description": "Game Cut: turn two whole-game camera recordings into one broadcast-style video, or cut highlights from a list of times. Choose the videos on this computer (nothing is uploaded), see exactly what it picked, then make the video. Runs on this computer only; no account, no database, no network.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 4605 --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --port 4605 --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf .next dist *.tsbuildinfo"
  },
  "dependencies": {
    "@hl-bos/game-cut": "workspace:*",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
