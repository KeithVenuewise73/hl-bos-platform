{
  "name": "@hl-bos/deploy",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-agnostic deployment abstraction. Headquarters and the verticals deploy THROUGH Herman Legacy Cloud; the hosting provider is a swappable adapter, never a hard dependency.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
