{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "hlg.prospect-import"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "report": {
      "type": "object",
      "properties": {
        "report_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "workspace_slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$"
        },
        "task_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "generated_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "is_synthetic": {
          "default": false,
          "type": "boolean"
        },
        "notes": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "report_id",
        "workspace_slug",
        "task_name",
        "generated_by",
        "generated_at"
      ]
    },
    "prospects": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "external_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "organization_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "organization_type": {
            "type": "string",
            "enum": [
              "league",
              "association",
              "organization",
              "facility",
              "team",
              "tournament_organizer",
              "other"
            ]
          },
          "official_website": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "location": {
            "type": "object",
            "properties": {
              "city": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "state_province": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "country": {
                "type": "string",
                "enum": [
                  "US",
                  "CA"
                ]
              }
            },
            "required": [
              "country"
            ]
          },
          "team_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              {
                "type": "null"
              }
            ]
          },
          "scoresheet_provider": {
            "type": "object",
            "properties": {
              "value": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "inferred",
                  "assumption",
                  "unknown"
                ]
              },
              "source_urls": {
                "default": [],
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 2000,
                  "format": "uri"
                }
              }
            },
            "required": [
              "value",
              "status"
            ]
          },
          "registration_provider": {
            "type": "object",
            "properties": {
              "value": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "inferred",
                  "assumption",
                  "unknown"
                ]
              },
              "source_urls": {
                "default": [],
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 2000,
                  "format": "uri"
                }
              }
            },
            "required": [
              "value",
              "status"
            ]
          },
          "analytics_capabilities": {
            "type": "object",
            "properties": {
              "value": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "inferred",
                  "assumption",
                  "unknown"
                ]
              },
              "source_urls": {
                "default": [],
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 2000,
                  "format": "uri"
                }
              }
            },
            "required": [
              "value",
              "status"
            ]
          },
          "decision_makers": {
            "default": [],
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "source_urls": {
                  "minItems": 1,
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 2000,
                    "format": "uri"
                  }
                },
                "email": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 254,
                      "format": "email",
                      "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "phone": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "name",
                "title",
                "source_urls"
              ]
            }
          },
          "business_contact": {
            "default": {
              "email": null,
              "phone": null,
              "address": null,
              "source_urls": []
            },
            "type": "object",
            "properties": {
              "email": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "phone": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "address": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_urls": {
                "default": [],
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 2000,
                  "format": "uri"
                }
              }
            }
          },
          "operational_needs": {
            "default": [],
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "need": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "verified",
                    "inferred",
                    "assumption",
                    "unknown"
                  ]
                },
                "source_urls": {
                  "default": [],
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 2000,
                    "format": "uri"
                  }
                }
              },
              "required": [
                "need",
                "status"
              ]
            }
          },
          "verified_facts": {
            "default": [],
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "statement": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "source_urls": {
                  "minItems": 1,
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 2000,
                    "format": "uri"
                  }
                }
              },
              "required": [
                "statement",
                "source_urls"
              ]
            }
          },
          "inferences_and_assumptions": {
            "default": [],
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "statement": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "basis": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "statement"
              ]
            }
          },
          "recommended_modules": {
            "default": [],
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "integration_recommendation": {
            "type": "string",
            "enum": [
              "integrate",
              "replace",
              "coexist",
              "undetermined"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "estimated_annual_contract_value": {
            "type": "object",
            "properties": {
              "amount": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "currency": {
                "type": "string",
                "enum": [
                  "USD",
                  "CAD"
                ]
              },
              "pricing_assumptions": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "amount",
              "currency"
            ]
          },
          "recommended_next_action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "research_date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "source_urls": {
            "default": [],
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2000,
              "format": "uri"
            }
          }
        },
        "required": [
          "external_ref",
          "organization_name",
          "organization_type",
          "official_website",
          "location",
          "team_count",
          "scoresheet_provider",
          "registration_provider",
          "analytics_capabilities",
          "integration_recommendation",
          "priority",
          "estimated_annual_contract_value",
          "recommended_next_action",
          "research_date"
        ]
      }
    }
  },
  "required": [
    "schema",
    "schema_version",
    "report",
    "prospects"
  ]
}
