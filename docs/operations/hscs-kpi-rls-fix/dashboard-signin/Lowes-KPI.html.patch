+// ─── Sign-in gate ─────────────────────────────────────────────────────
+// The data tables only answer to signed-in HSCS staff. supabase-js keeps the session in the browser and sends
+// the user's token with every request, so nothing below needs to know about it. Signing out unmounts <App/>,
+// which drops the loaded data from memory.
+function AuthGate({ children }) {
+  const [session, setSession] = useState(undefined); // undefined = still checking
+  const [email, setEmail] = useState("");
+  const [password, setPassword] = useState("");
+  const [err, setErr] = useState("");
+  const [busy, setBusy] = useState(false);
+
+  useEffect(() => {
+    supabase.auth.getSession().then(({ data }) => setSession(data.session || null));
+    const { data: sub } = supabase.auth.onAuthStateChange((_event, s) => setSession(s || null));
+    return () => sub.subscription.unsubscribe();
+  }, []);
+
+  const signIn = async (e) => {
+    e.preventDefault(); setBusy(true); setErr("");
+    const { error } = await supabase.auth.signInWithPassword({ email: email.trim(), password });
+    if (error) setErr(error.message === "Invalid login credentials" ? "Email or password not recognised." : error.message);
+    setBusy(false);
+  };
+
+  const shell = { minHeight: "100vh", display: "flex", alignItems: "center", justifyContent: "center", background: "#060f1e", color: "#e2e8f0", fontFamily: "'Inter','Segoe UI',sans-serif" };
+  const field = { width: "100%", padding: "10px 12px", marginTop: 6, marginBottom: 14, borderRadius: 8, border: "1px solid #334155", background: "#0f172a", color: "#e2e8f0", fontSize: 14 };
+
+  if (session === undefined) return <div style={shell}>Checking sign-in…</div>;
+  if (!session) {
+    return (
+      <div style={shell}>
+        <form onSubmit={signIn} style={{ width: 340, padding: 28, borderRadius: 14, background: "#0b1730", border: "1px solid #1e293b" }}>
+          <div style={{ fontSize: 18, fontWeight: 700, marginBottom: 4 }}>Lowe's KPI Dashboard</div>
+          <div style={{ fontSize: 13, color: "#94a3b8", marginBottom: 20 }}>Sign in with your Herman Supply Chain Solutions staff account.</div>
+          <label style={{ fontSize: 12, color: "#94a3b8" }}>Email</label>
+          <input type="email" autoComplete="username" required value={email} onChange={(e) => setEmail(e.target.value)} style={field} />
+          <label style={{ fontSize: 12, color: "#94a3b8" }}>Password</label>
+          <input type="password" autoComplete="current-password" required value={password} onChange={(e) => setPassword(e.target.value)} style={field} />
+          {err && <div role="alert" style={{ color: "#f87171", fontSize: 13, marginBottom: 12 }}>{err}</div>}
+          <button type="submit" disabled={busy} style={{ width: "100%", padding: "11px 0", border: "none", borderRadius: 8, background: "linear-gradient(90deg,#0ea5e9,#3b82f6)", color: "#fff", fontWeight: 600, fontSize: 15, cursor: "pointer" }}>{busy ? "Signing in…" : "Sign in"}</button>
+        </form>
+      </div>
+    );
+  }
+  return (
+    <React.Fragment key={session.user.id}>
+      <button onClick={() => supabase.auth.signOut()} style={{ position: "fixed", top: 10, right: 12, zIndex: 1000, padding: "6px 12px", borderRadius: 8, border: "1px solid #334155", background: "#0f172a", color: "#94a3b8", fontSize: 12, cursor: "pointer" }}>Sign out ({session.user.email})</button>
+      {children}
+    </React.Fragment>
+  );
+}
+
 try {
-  ReactDOM.createRoot(document.getElementById('root')).render(<App />);
+  ReactDOM.createRoot(document.getElementById('root')).render(<AuthGate><App /></AuthGate>);
