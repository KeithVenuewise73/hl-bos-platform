 const HEADERS = { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}`, 'Content-Type': 'application/json', 'Prefer': 'return=representation', 'Accept-Profile': 'dpi', 'Content-Profile': 'dpi' };
 
+// Sign-in: the public key only identifies the project. Data requests carry the signed-in user's token instead,
+// so HEADERS.Authorization is replaced on sign-in and on every silent token refresh (same object, used everywhere).
+const authClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
+HEADERS['Authorization'] = '';
+let appStarted = false;
+function startAuth(){
+  const gate = document.getElementById('authGate');
+  const out = document.getElementById('signOutBtn');
+  const err = document.getElementById('authError');
+  document.getElementById('authForm').addEventListener('submit', async (e) => {
+    e.preventDefault();
+    const btn = document.getElementById('authSubmit');
+    btn.disabled = true; err.style.display = 'none';
+    const { error } = await authClient.auth.signInWithPassword({
+      email: document.getElementById('authEmail').value.trim(),
+      password: document.getElementById('authPassword').value
+    });
+    if (error) {
+      err.textContent = error.message === 'Invalid login credentials' ? 'Email or password not recognised.' : error.message;
+      err.style.display = 'block';
+    }
+    btn.disabled = false;
+  });
+  out.addEventListener('click', () => authClient.auth.signOut());
+  authClient.auth.onAuthStateChange((event, session) => {
+    if (event === 'SIGNED_OUT') { location.reload(); return; }   // drops everything that was loaded
+    if (session) {
+      HEADERS['Authorization'] = 'Bearer ' + session.access_token;
+      gate.style.display = 'none';
+      out.style.display = 'block'; out.textContent = 'Sign out (' + session.user.email + ')';
+      if (!appStarted) { appStarted = true; init(); }
+    } else {
+      gate.style.display = 'flex'; out.style.display = 'none';
+    }
+  });
+}
