# Fail the install if local pnpm differs from packageManager in package.json.
# Prevents "works on my machine" lockfile churn.
package-manager-strict=true

# Reproducible CI installs.
prefer-frozen-lockfile=true

# Security: do not run arbitrary install scripts from transitive deps.
# Add specific packages to onlyBuiltDependencies when genuinely required.
enable-pre-post-scripts=false

# Fail fast on peer dependency conflicts rather than silently installing a
# broken tree. This is the setting that surfaces problems like
# typescript@7 vs typescript-eslint@8 at install time, not at CI time.
strict-peer-dependencies=true
auto-install-peers=false
