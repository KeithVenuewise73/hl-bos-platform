{
  "name": "hl-bos-platform",
  "version": "0.1.0",
  "private": true,
  "description": "HL-BOS — Herman Legacy Business Operating System. Reusable multi-tenant AI business platform.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lineage": "node scripts/check-lineage.mjs",
    "lineage:write": "node scripts/check-lineage.mjs --write",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm lineage && pnpm test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.5",
    "semver": "7.8.5",
    "turbo": "2.10.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  },
  "workspaces": ["apps/*", "packages/*"],
  "catalog": {
    "typescript": "6.0.3",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "zod": "4.4.3",
    "@anthropic-ai/sdk": "0.126.0",
    "@supabase/supabase-js": "2.110.6",
    "@supabase/ssr": "0.12.3",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "exifr": "7.1.3",
    "heic-convert": "2.1.0",
    "tesseract.js": "7.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "vitest": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "@types/node": "22.20.1"
  }
}
